					Source = Csv.Document(File.Contents(DataFolder & "\FactFlights.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"FlightID", Int64.Type}, {"DateKey", Int64.Type}, {"FlightNumber", type text}, {"AirlineKey", Int64.Type}, {"RouteKey", Int64.Type}, {"AircraftType", type text}, {"ScheduledDeparture", type datetime}, {"ActualDeparture", type datetime}, {"ScheduledArrival", type datetime}, {"ActualArrival", type datetime}, {"DepartureDelayMin", Int64.Type}, {"ArrivalDelayMin", Int64.Type}, {"Cancelled", Int64.Type}, {"DelayCause", type text}, {"CancelReason", type text}, {"SeatsAvailable", Int64.Type}, {"Passengers", Int64.Type}, {"AvgFareINR", Int64.Type}, {"RevenueINR", Int64.Type}, {"BaggageKg", Int64.Type}}, "en-US")
				in
					Typed

