	column 'Delay Bucket' = SWITCH(TRUE(), FactFlights[Cancelled] = 1, "Cancelled", FactFlights[ArrivalDelayMin] <= 15, "On time", FactFlights[ArrivalDelayMin] <= 60, "15-60 min", FactFlights[ArrivalDelayMin] <= 180, "1-3 hrs", "3+ hrs")
		dataType: string
