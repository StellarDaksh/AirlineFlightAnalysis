	partition QnA = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\QnA.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"No", Int64.Type}, {"Section", type text}, {"Question", type text}, {"Answer", type text}}, "en-US")
				in
					Typed

